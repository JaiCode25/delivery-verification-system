# Delivery Verification System - Backend Configuration Example
# Copy this file to .env for local overrides (do not commit actual .env)

DATABASE_URL=sqlite:///./storage/delivery_verification.db
UPLOAD_DIR=./storage/uploads
FRAME_DIR=./storage/frames
RESULT_DIR=./storage/results
REPORT_DIR=./storage/reports
MAX_FILE_SIZE=209715200
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
